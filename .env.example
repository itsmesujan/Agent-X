# ==============================================================================
# Agent-X Environment Configuration Template (.env.example)
# Copy this file to .env and configure values before running locally or deploying.
# ==============================================================================

# --- Application & Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true
PORT=8000
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# --- Google Cloud Platform ---
GCP_PROJECT_ID=agent-x-dev
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=

# --- Gemini & Google Gen AI ---
GEMINI_API_KEY=
DEFAULT_REASONING_MODEL=gemini-2.5-pro
DEFAULT_FAST_MODEL=gemini-2.5-flash

# --- Google Cloud Firestore ---
FIRESTORE_DATABASE=(default)
FIRESTORE_EMULATOR_HOST=localhost:8080

# --- Google Cloud Pub/Sub ---
PUBSUB_EMULATOR_HOST=localhost:8085
PUBSUB_TOPIC_TASK_DISPATCH=agentx-task-dispatch-dev
PUBSUB_TOPIC_TELEMETRY=agentx-telemetry-events-dev
PUBSUB_TOPIC_RECOVERY=agentx-recovery-events-dev
PUBSUB_TOPIC_DEAD_LETTER=agentx-dead-letter-queue-dev
PUBSUB_SUBSCRIPTION_WORKER=agentx-worker-task-sub-dev

# --- Google Cloud Storage ---
GCS_EVIDENCE_BUCKET=agentx-evidence-artifacts-dev

# --- Google Secret Manager ---
SECRET_MANAGER_ENABLED=false

# --- Resource Brain & Mission Bounds ---
DEFAULT_MISSION_USD_CAP=5.00
DEFAULT_MISSION_TOKEN_CAP=1000000
DEFAULT_MISSION_TIMEOUT_SECONDS=3600
MAX_PARALLEL_TASKS=8

# --- Security & Auth ---
JWT_SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
AUTH_ENABLED=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Next.js Web App (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1
NEXT_PUBLIC_GCP_PROJECT_ID=agent-x-dev
NEXT_PUBLIC_ENVIRONMENT=development
